{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "bun.lock"],
  "tasks": {
    "typecheck": {
      "description": "型検査 (tsc --noEmit)",
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "e2e/**", "tsconfig.json", "tsconfig.*.json", "package.json"],
      "outputs": []
    },
    "build": {
      "description": "ビルド成果物を持つ package 用 (現状は枠のみ)",
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "tsconfig.*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "test": {
      "description": "テスト (Bun は TS を直接解決するため ^build ではなく ^typecheck に依存)",
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "tsconfig.json", "tsconfig.*.json", "package.json"],
      "outputs": []
    },
    "test:e2e": {
      "description": "E2E テスト (実 DB に対して migration → app.request)。cache 無効: 外部 DB 状態に依存するため",
      "dependsOn": ["^typecheck"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"],
      "inputs": ["src/**", "e2e/**", "tsconfig.json", "package.json"]
    },
    "dev": {
      "description": "開発用永続タスク (cache 無効、env はキャッシュキーに影響させない)",
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL", "PORT", "PREP_HAMSTER_*"]
    }
  }
}
