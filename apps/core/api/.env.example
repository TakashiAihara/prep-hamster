DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PORT=3000
# 写真の保存先 (Supabase Storage) の URL と secret key。どちらかが無いと写真の route だけが 503 になる。
# 本物の値はここに書かない (本番は Infisical の prep-hamster/prod を API の runtime env に渡す)。
# SUPABASE_URL: 手元は `bunx supabase start` が出す API URL (http://127.0.0.1:54321)。
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# API が container の中などで SUPABASE_URL が端末から届かないときだけ、署名 URL の origin に使う端末から届く URL。空なら SUPABASE_URL のまま
SUPABASE_PUBLIC_URL=
