{
  "name": "@prep-hamster/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/app.ts",
  "module": "./src/app.ts",
  "types": "./src/app.ts",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "import": "./src/app.ts",
      "default": "./src/app.ts"
    },
    "./server": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "job:expiry-notify": "bun run src/jobs/expiry-notify.ts",
    "typecheck": "tsgo --noEmit",
    "test": "bun test src",
    "test:e2e": "bun test e2e"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@prep-hamster/db": "workspace:*",
    "@prep-hamster/jan-api": "workspace:*",
    "@prep-hamster/schema": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.13",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  }
}
