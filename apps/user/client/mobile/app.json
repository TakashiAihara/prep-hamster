{
  "expo": {
    "name": "prep-hamster",
    "slug": "prep-hamster",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "prep-hamster",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.prephamster"
    },
    "android": {
      "package": "com.example.prephamster"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "JAN コードの読み取りと、商品の写真の撮影にカメラを使用します"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "商品に付ける写真を選ぶために写真ライブラリを使用します",
          "cameraPermission": "JAN コードの読み取りと、商品の写真の撮影にカメラを使用します",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-status-bar",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
