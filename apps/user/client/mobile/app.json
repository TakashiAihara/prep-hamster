{
  "expo": {
    "name": "prep-hamster",
    "slug": "prep-hamster",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "prep-hamster",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.prephamster"
    },
    "android": {
      "package": "com.example.prephamster"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "JAN コードを読み取って商品を登録するためにカメラを使用します"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
