views {
  view landscape {
    title 'System landscape'
    include user, operator
    include userPhone, userPhone.mobile, userPc, userPc.userCli, opPc, opPc.adminCli
    include apiHost, apiHost.api, expiryJob, adminWeb
    include lib.clientPkg, lib.dbPkg, supabase.auth, supabase.pg, google, expoPush, fcm
    style element.tag = #planned {
      opacity 40%
      border dashed
    }
    autoLayout LeftRight
  }

  view clients of apiHost.api {
    title 'Clients and sign-in'
    include userPhone.mobile, userPc.userCli, adminWeb
    include lib.clientPkg, apiHost.api, supabase.auth, google
    style element.tag = #planned {
      opacity 40%
      border dashed
    }
    autoLayout LeftRight
  }

  view api of apiHost.api {
    title 'Core API internals'
    include apiHost.api.*
    include lib.schemaPkg, lib.dbPkg, lib.janPkg
    include supabase.auth, supabase.pg, yahoo
    autoLayout LeftRight
  }

  view mobile of userPhone.mobile {
    title 'Mobile app'
    include userPhone.mobile.*
    include lib.clientPkg, apiHost.api, supabase.auth, google
    autoLayout LeftRight
  }

  view notification {
    title 'Expiry notification'
    include expiryJob, expiryJob.*
    include lib.dbPkg, supabase.pg, expoPush, fcm, userPhone.mobile
    autoLayout LeftRight
  }
}
