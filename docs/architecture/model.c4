model {
  user = person 'Household member' {
    description 'Manages stock (location, quantity, expiry) shared in a group'
  }
  operator = person 'Operator' {
    description 'Administers groups and runs bulk operations'
  }

  userPhone = host 'Android device' {
    icon tech:android
    description 'The household member own device'
    mobile = process 'Mobile app' {
      icon tech:react
      description 'Expo (Managed) app: stock list, barcode scan, groups, locations'
      router = module 'Expo Router screens' 'app/ (tabs, add, stocks, auth)'
      query = module 'TanStack Query hooks' 'use-stocks, use-stock-actions, ...'
      authClient = module 'Auth session' 'supabase.ts / auth.ts: Google sign-in, access token'
      camera = module 'expo-camera' 'JAN (EAN-13) barcode reading'
    }
  }

  userPc = host 'User machine' {
    icon tech:bun
    description 'The household member own computer'
    userCli = process 'user CLI' {
      icon tech:bun
      description 'apps/user/client/cli: login, stock add / list'
    }
  }

  opPc = host 'Operator machine' {
    icon tech:bun
    adminCli = process 'administrator CLI' {
      description 'apps/administrator/client/cli'
    }
  }

  adminWeb = process 'Administrator web' {
    #planned
    description 'TanStack Start + shadcn/ui, not implemented yet'
  }

  coolify = host 'Coolify host' {
    icon tech:docker
    description 'Container host that runs the API image'
    api = process 'Core API' {
      icon tech:hono
      description 'Hono on Bun, one container, GET /health probed'
      authMw = module 'Auth middleware' 'Verifies the Supabase access token with JWKS, creates the users row on first request'
      routes = module 'REST routes /v1' 'groups, locations, categories, items, stocks, push-tokens, memberships, invitations'
      openapi = module 'Validation and OpenAPI' 'Zod request validation, 422 VALIDATION_ERROR'
    }
  }

  expiryJob = process 'Expiry notification job' {
    #job
    description 'One-shot bun script (job:expiry-notify). The scheduling host is not defined in the repo yet (#134)'
    selector = module 'Expiring stock selector' 'Per user: notification_settings (default 7 days before), one push per day'
    sender = module 'Expo push sender' 'Sends batches, removes DeviceNotRegistered tokens'
  }

  lib = system 'Shared packages' {
    schemaPkg = module '@prep-hamster/schema' 'Zod schemas and types, single source of truth'
    dbPkg = module '@prep-hamster/db' 'Drizzle schema and migrations'
    clientPkg = module '@prep-hamster/api-client' 'Typed Hono hc client shared by mobile and CLIs'
    janPkg = module '@prep-hamster/jan-api' 'JAN lookup: Yahoo provider, stub provider'
    syncPkg = module '@prep-hamster/sync' 'Offline sync and conflict resolution' { #planned }
  }

  supabase = external 'Supabase (Tokyo region)' {
    icon tech:supabase
    description 'Managed service'
    auth = module 'Supabase Auth' 'OAuth only (Google), issues ES256 / RS256 access tokens, publishes JWKS'
    pg = store 'Postgres' 'users, groups, memberships, locations, items, stocks, push_tokens, notification_settings, ...'
  }
  google = external 'Google OAuth' 'Sign-in identity provider'
  yahoo = external 'Yahoo! Shopping API' 'Product search used to resolve a JAN code'
  expoPush = external 'Expo push service' 'Relays notifications to FCM'
  fcm = external 'FCM' 'Delivers the push to the device'

  user -> userPhone.mobile 'Uses'
  user -> userPc.userCli 'Scripts'
  operator -> opPc.adminCli 'Operates'

  userPhone.mobile.router -> userPhone.mobile.query 'Reads and mutates'
  userPhone.mobile.router -> userPhone.mobile.camera 'Scans barcode'
  userPhone.mobile.query -> userPhone.mobile.authClient 'Gets access token'
  userPhone.mobile.authClient -> supabase.auth 'Signs in' 'HTTPS'
  supabase.auth -> google 'Delegates identity' 'OAuth'
  userPhone.mobile.query -> coolify.api 'REST + Bearer token' 'HTTPS'
  userPc.userCli -> coolify.api 'REST + Bearer token' 'HTTPS'
  opPc.adminCli -> coolify.api 'REST + Bearer token' 'HTTPS'

  coolify.api.authMw -> coolify.api.routes 'Passes current user'
  coolify.api.routes -> coolify.api.openapi 'Validates with'
  coolify.api.authMw -> supabase.auth 'Fetches JWKS' 'HTTPS'
  coolify.api.routes -> supabase.pg 'Drizzle queries' 'SQL'
  coolify.api.routes -> lib.janPkg 'Resolves JAN with'
  coolify.api.routes -> lib.dbPkg 'Uses'
  coolify.api.openapi -> lib.schemaPkg 'Uses'
  lib.dbPkg -> lib.schemaPkg 'Types tied to'
  lib.janPkg -> yahoo 'Searches products' 'HTTPS'

  expiryJob.selector -> supabase.pg 'Reads stocks, removes dead tokens' 'SQL'
  expiryJob.selector -> expiryJob.sender 'Messages'
  expiryJob.sender -> expoPush 'Sends push' 'HTTPS'
  expoPush -> fcm 'Relays'
  fcm -> userPhone.mobile 'Delivers notification'
}
